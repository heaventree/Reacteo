{
  "name": "reacteo",
  "version": "2.0.0",
  "description": "SEO, AEO and GEO toolkit for React: meta tags, Schema.org JSON-LD, sitemaps, robots.txt with AI-crawler policy, llms.txt, server-side meta injection and admin tools.",
  "private": false,
  "type": "module",
  "main": "./dist/lib/index.cjs",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.cjs"
    },
    "./server": {
      "types": "./dist/lib/server.d.ts",
      "import": "./dist/lib/server.js",
      "require": "./dist/lib/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib",
    "README.md",
    "INSTALLATION.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "react",
    "seo",
    "meta-tags",
    "open-graph",
    "twitter-cards",
    "structured-data",
    "schema-org",
    "json-ld",
    "sitemap",
    "robots-txt",
    "ai",
    "openai",
    "claude",
    "gemini",
    "typescript",
    "supabase",
    "server-side-rendering",
    "ssr",
    "crawler",
    "social-sharing",
    "metadata",
    "react-helmet",
    "indexnow",
    "google-search-console",
    "production",
    "battle-tested"
  ],
  "author": "Sean O'Byrne <sean@heaventree.co> (https://heaventree.co)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/heaventree-ltd/reacteo.git"
  },
  "bugs": {
    "url": "https://github.com/heaventree-ltd/reacteo/issues"
  },
  "homepage": "https://github.com/heaventree-ltd/reacteo#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/generate-sitemap.js && node scripts/generate-robots.js && node scripts/generate-llms-txt.js",
    "build:lib": "vite build --config vite.lib.config.ts && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "seo:audit": "node scripts/seo-audit.js",
    "seo:audit:pre-deploy": "npm run build && npm run seo:audit",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "seo:llms": "node scripts/generate-llms-txt.js",
    "seo:robots": "node scripts/generate-robots.js",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build:lib",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-helmet-async": "^2.0.0 || ^3.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "lucide-react": "^1.28.0",
    "sitemap": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "tailwindcss": "^3.4.1",
    "terser": "^5.46.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
